            "description": "Ping ao Redis bem-sucedido nesta verificação"
          },
          "open_cache_age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Cache Age Seconds",
            "description": "Idade do cache da abertura, em segundos; null se nunca populado"
          },
          "close_cache_age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Cache Age Seconds",
            "description": "Idade do cache do fechamento, em segundos; null se nunca populado"
          },
          "open_cache_expired": {
            "type": "boolean",
            "title": "Open Cache Expired",
            "description": "Cache da abertura ausente ou mais velho que o TTL"
          },
          "close_cache_expired": {
            "type": "boolean",
            "title": "Close Cache Expired",
            "description": "Cache do fechamento ausente ou mais velho que o TTL"
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "title": "Cache Ttl Seconds",
            "description": "TTL configurado (CACHE_TTL_SECONDS)"
          }
        },
        "type": "object",
        "required": [
          "redis_connected",
          "open_cache_age_seconds",
          "close_cache_age_seconds",
          "open_cache_expired",
          "close_cache_expired",
          "cache_ttl_seconds"
