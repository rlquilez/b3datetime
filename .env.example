# Variáveis de ambiente da B3 DateTime API.
# Copie para .env e ajuste o que precisar: `cp .env.example .env`.
# Todos os valores abaixo são os padrões da aplicação; nomes são case-insensitive.

# --- Redis ---------------------------------------------------------------------
# URL de conexão (nome preferencial). REDIS_URL também é aceito, com precedência menor.
REDIS_URL_ENV=redis://localhost:6379
# Chaves com os horários no formato HH:MM, gravadas por um processo externo.
REDIS_KEY_OPEN=b3:trading:hours:open
REDIS_KEY_CLOSE=b3:trading:hours:close
# Intervalo mínimo entre tentativas de reconexão e timeout de socket, em segundos.
REDIS_RECONNECT_INTERVAL_SECONDS=30
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Cache local ---------------------------------------------------------------
# Por quanto tempo os horários continuam sendo servidos se o Redis cair.
CACHE_TTL_SECONDS=3600

# --- Calendário ----------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
EXCHANGE_NAME=BVMF
# Anos para trás na construção do calendário (a janela é móvel).
CALENDAR_START_OFFSET_YEARS=10
# Span máximo aceito por /v1/trading-days, em dias.
MAX_RANGE_DAYS=3660

# --- Proxy reverso -------------------------------------------------------------
# Prefixo sob o qual o gateway publica a API (ex.: /b3datetime). Vazio sem proxy.
ROOT_PATH=

# --- Documentação --------------------------------------------------------------
# Só afeta a documentação: true declara o esquema `apikey` no OpenAPI e em GET /.
# Quem valida a chave é o Kong; a aplicação não autentica nada.
API_KEY_REQUIRED=false
API_TITLE=B3 DateTime API
# API_DESCRIPTION aceita Markdown; o padrão está em src/config.py.
# API_VERSION é sincronizada pela release — não sobrescreva.
